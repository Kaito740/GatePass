# Base de datos — "db" es el nombre del contenedor en docker-compose
DATABASE_URL=postgresql://usuario:password@db:5432/gatepass

# JWT — cámbialo por algo largo y aleatorio en producción
SECRET_KEY=cambia_esto_por_un_string_largo_y_aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ollama — "ollama" es el nombre del contenedor
OLLAMA_URL=http://ollama:11434

# n8n — "n8n" es el nombre del contenedor
N8N_WEBHOOK_URL=http://n8n:5678/webhook

# Superadmin inicial — creado automáticamente al arrancar
SUPERADMIN_DNI=00000000
SUPERADMIN_NOMBRES=Admin
SUPERADMIN_APELLIDOS=Sistema
SUPERADMIN_PASSWORD=cambia_esto_en_produccion
